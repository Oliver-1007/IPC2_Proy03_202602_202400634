@page
@model InicializarModel
@{ ViewData["Title"] = "Inicializar sistema"; }
@if (Model.Mensaje != null) { <div class="ok">@Model.Mensaje</div> }
@if (Model.Error != null) { <div class="error">@Model.Error</div> }
<div class="panel">
    <p>Esta acción borra todo el RTU y todas las facturas almacenadas en la API. No se puede deshacer.</p>
    <form method="post" onsubmit="return confirm('¿Borrar todos los datos del sistema?');">
        <button type="submit" class="rojo">Borrar todos los datos</button>
    </form>
</div>
